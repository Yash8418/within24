# Copy to .env (or set in your host's dashboard). Never commit real values.

# PostgreSQL in production; defaults to a local SQLite file when unset.
# postgres:// and postgresql:// URLs are both accepted.
DATABASE_URL=postgresql://user:password@host:5432/within24

# Long random string used to sign login tokens, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# How long a login lasts, in minutes.
ACCESS_TOKEN_MINUTES=60
